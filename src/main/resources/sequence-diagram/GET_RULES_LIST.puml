@startuml
'https://plantuml.com/sequence-diagram
' Sequence Diagram: GET /api/v1/promotion-rules - List Promotion Rules

title GET Promotion Rules - List with Filters

actor Client
participant "PromotionRuleController\n(adapter/in/web)" as Controller
participant "PromotionRuleService\n(application/service)" as Service
participant "PromotionRuleDomainService\n(domain/service)" as DomainService
participant "PromotionRuleRepository\n(domain/repository)" as Repository
participant "PromotionRuleRepositoryAdapter\n(infrastructure/persistence/adapter)" as Adapter
participant "JpaPromotionRuleRepository\n(infrastructure/persistence/repository)" as JpaRepo
database "MySQL\npromotion_rules" as DB

== Success Flow ==
Client -> Controller: GET /api/v1/promotion-rules?status=ACTIVE&page=1&size=20
activate Controller
Controller -> Controller: validateQueryParams
alt invalid parameters
    Client <-- Controller: 400
    note right of Client
    {
      "code": "invalid_request",
      "message": "Invalid status value"
    }
    end note
    deactivate Controller
end

Controller -> Service: listPromotionRules(filters, page, size)
activate Service

Service -> Repository: findByFilters(status, templateId, active, pageable)
activate Repository

Repository -> Adapter: findByFilters(status, templateId, active, pageable)
activate Adapter

Adapter -> JpaRepo: findAll(specification, pageable)
activate JpaRepo

JpaRepo -> DB: SELECT * FROM promotion_rules\nWHERE status = ? AND active = ?\nLIMIT ? OFFSET ?
DB --> JpaRepo: List<PromotionRuleEntity>

JpaRepo --> Adapter: Page<PromotionRuleEntity>
deactivate JpaRepo

Adapter -> Adapter: map entities to domain models
Adapter --> Repository: Page<PromotionRule>
deactivate Adapter

Repository --> Service: Page<PromotionRule>
deactivate Repository

Service -> Service: map domain models to DTOs
Service --> Controller: PagedResponse<PromotionRuleResponse>
deactivate Service

Controller --> Client: 200 OK
note right of Client
{
  "code": "success",
  "data": {
    "items": [
      {
        "id": 1,
        "template_id": 1,
        "rule_name": "Buy 2 Get 1 Free",
        "start_date": "2025-11-01T00:00:00",
        "end_date": "2025-12-31T23:59:59",
        "active": true,
        "priority": 10,
        "quota": {"type":"GLOBAL","limit":1000},
        "quota_used": 150
      }
    ],
    "total": 5,
    "page": 1,
    "size": 20
  }
}
end note
deactivate Controller

== Error Flow: Invalid Parameters ==
Client -> Controller: GET /api/v1/promotion-rules?status=INVALID
activate Controller
Controller -> Controller: validateQueryParams
Controller --> Client: 400
note right of Client
{
  "code": "invalid_request",
  "message": "Invalid status value. Must be ACTIVE, INACTIVE, or EXPIRED"
}
end note
deactivate Controller

== Error Flow: Empty Results ==
Client -> Controller: GET /api/v1/promotion-rules?templateId=999
activate Controller
Controller -> Service: listPromotionRules(filters, page, size)
activate Service
Service -> Repository: findByFilters(status, templateId, active, pageable)
activate Repository
Repository -> Adapter: findByFilters(status, templateId, active, pageable)
activate Adapter
Adapter -> JpaRepo: findAll(specification, pageable)
activate JpaRepo
JpaRepo -> DB: SELECT * FROM promotion_rules\nWHERE template_id = 999
DB --> JpaRepo: []
JpaRepo --> Adapter: Page.empty()
deactivate JpaRepo
Adapter --> Repository: Page.empty()
deactivate Adapter
Repository --> Service: Page.empty()
deactivate Repository
Service --> Controller: PagedResponse(empty)
deactivate Service
Controller --> Client: 200 OK
note right of Client
{
  "code": "success",
  "data": {
    "items": [],
    "total": 0,
    "page": 1,
    "size": 20
  }
}
end note
deactivate Controller

@enduml

