@startuml
'https://plantuml.com/sequence-diagram

title BuildRuleIndex Scheduler → DB → In-Memory Cache

actor Scheduler
participant "RuleIndexScheduler\n(infrastructure/adapter/in/scheduler)" as SchedulerAdapter
participant "RuleIndexBuildService\n(application/service)" as BuildService
participant "RuleIndexBuilder\n(domain/service)" as DomainBuilder
participant "PromotionRuleRepository\n(infrastructure/adapter/out/persistence)" as Repository
participant "RuleIndexCache\n(infrastructure/cache)" as Cache

Scheduler -> SchedulerAdapter: triggerBuildRuleIndex()
activate SchedulerAdapter

SchedulerAdapter -> BuildService: buildRuleIndex()
activate BuildService

BuildService -> Repository: findAllActiveRules()
activate Repository

Repository -> Repository: SELECT * FROM promotion_rules\nWHERE status = 'ACTIVE'
note right of Repository
ref: ~/resources/db.migrations/V1_create_promotion_rules_tables.sql
Tables read: promotion_rules,\npromotion_condition,\npromotion_action
end note

Repository --> BuildService: List<PromotionRuleEntity>
deactivate Repository

BuildService -> DomainBuilder: generateRuleIndex(List<PromotionRule>)
activate DomainBuilder

DomainBuilder -> DomainBuilder: parseConditions()\nextractMappings()
note right of DomainBuilder
- include_product_ids\n- include_category_ids\n- payment_method\n- customer_segment
end note

DomainBuilder --> BuildService: RuleIndex\n(product→rules,\ncategory→rules,\npayment→rules)
deactivate DomainBuilder

BuildService -> Cache: saveRuleIndex(ruleIndex)
activate Cache

Cache -> Cache: write in Redis\nHSET promotion_rule_index ...
note right of Cache
- product_rule_map\n- category_rule_map\n- payment_rule_map\n- segment_rule_map
TTL: optional
end note

Cache --> BuildService: OK
deactivate Cache

BuildService --> SchedulerAdapter: Build completed
deactivate BuildService

SchedulerAdapter --> Scheduler: 200 OK
note right of Scheduler
{
  "code": "SUCCESS",
  "message": "RuleIndex built successfully"
}
end note
deactivate SchedulerAdapter

@enduml
