@startuml
'https://plantuml.com/sequence-diagram

title EvaluatePromotionRuleDetail POST /api/v1/promotion-rules/evaluate

actor Client
participant "PromotionEvaluationController\n(infrastructure/adapter/in/web)" as Controller
participant "PromotionEvaluationService\n(application/service)" as Service
participant "RuleCache\n(infrastructure/adapter/cache)" as Cache
participant "PromotionRuleDomainService\n(domain/service)" as DomainService

Client -> Controller
activate Controller
'Controller -> Controller: validateQueryParams
'alt invalid parameters
'    Client <-- Controller: 400
'    note right of Client
'    {
'      "code": "invalid_request",
'      "message": "Invalid status value"
'    }
'    end note
'    deactivate Controller
'end



'RuleIndex -> RuleIndex: lookup SKU ruleIds\n( product_rule_map[sku] )
'RuleIndex -> RuleIndex: lookup category ruleIds\n( category_rule_map[category] )
'RuleIndex -> RuleIndex: lookup payment ruleIds\n( payment_rule_map[payment] )
'RuleIndex -> RuleIndex: lookup segment ruleIds\n( segment_rule_map[segment] )


Controller -> Service: evaluatePromotionRules(carts, paymentMethod)
activate Service

'Service -> DomainService: evaluatePromotionRules(carts, paymentMethod)
'activate DomainService

loop for each cart in carts
    Service -> Cache: findRuleIdsBySku(cart.sku)
    Service <-- Cache: List<ruleIds>
end
Service -> Cache: findRuleIdsByPaymentMethod(paymentMethod)
Service <-- Cache: List<ruleIds>

Service -> Service: filterRuleIds(mergedRuleIds)
note right of Service
- filter by current time (end)
- deduplicate ruleIds
end note
loop for each ruleId in filteredRuleIds
    Service -> Cache: getEvaluatePromotionRule(filteredRuleIds)
    Service <-- Cache: EvaluatePromotionRule
end

Service -> DomainService: evaluateEligibleRules(carts, evaluateRules)
DomainService -> DomainService: applyCondition(ConditionType.QUANTITY, carts, evaluateRules)
note right of DomainService
'- filter by quota
'- sortEvaluatePromotionRulesByPriority
end note
Service <-- DomainService: List<EvaluatePromotionRule>


Service -> Service: transformToEvaluatePromotionRuleResult(EvaluatePromotionRule)
Service --> Controller: EvaluatePromotionRuleResult
deactivate Service

Controller --> Client: 200 OK
note right of Client
return ref: tags: [promotionEvaluation]  ~/openapi/promotion-engine-api.yaml
end note
deactivate Controller

@enduml

