@startuml
'https://plantuml.com/sequence-diagram

title EvaluatePromotionRuleDetail POST /api/v1/promotion-rules/evaluate

actor Client
participant "PromotionEvaluationController\n(infrastructure/adapter/in/web)" as Controller
participant "PromotionEvaluationService\n(application/service)" as Service
participant "RuleEvaluationDomainService\n(domain/service)" as DomainService
participant "RuleCache\n(infrastructure/adapter/cache)" as Cache

Client -> Controller
activate Controller

Controller -> Service: evaluatePromotionRules(carts, paymentMethod)
activate Service

loop for each cart in carts
    Service -> Cache: findRuleIdsByProductId(cart.productId)
    activate Cache
    Service <-- Cache: List<ruleIds>

    Service -> Cache: findRuleIdsByCategoryId(cart.categoryId)
    Service <-- Cache: List<ruleIds>
end
Service -> Cache: findRuleIdsByPaymentMethod(paymentMethod)
Service <-- Cache: List<ruleIds>

Service -> Cache: findRuleIdsByCondition(ConditionType.TOTAL_BILL) // from globalRuleMap
Service <-- Cache: List<ruleIds>
deactivate Cache

Service -> Service: arrangeRuleIds(mergedRuleIds)
note right of Service
- filter out by current time (end)
- deduplicate ruleIds
- sort by priority ASC by rule.priority
end note

Service -> DomainService: evaluateEligibleRules(carts, sortedRules, paymentMethod)
activate DomainService
loop for each ruleId in sortedRuleIds
    DomainService -> Cache: getEvaluatePromotionRule(ruleId)
    DomainService <-- Cache: EvaluatePromotionRule

    DomainService -> DomainService: applyCondition(rule.conditions, carts, evaluateRules)
    note right of DomainService
    switch
    PRODUCT: Check if cart items contains one from productCode list
    CATEGORY: Check if cart items contains one from categoryCode list
    QUANTITY: Check if cart items meet minimum quantity threshold using productCode or categoryCode list
    AMOUNT: Check if cart items meet minimum amount threshold using productCode or categoryCode list
    PAYMENT_METHOD: Check if payment method matches
    TOTAL_BILL Calculate total bill = sum of all(item.quantity * item.price) if total meets minimum threshold
    end note
end

DomainService -> DomainService: deriveExclusiveByScope(eligibleRules)
note right of DomainService
1) derive scopeKey on-the-fly from rule.conditions:
   - if any condition.type == TOTAL_BILL -> scopeKey = "ORDER"
   - else if condition.productCodes not empty -> scopeKey = "PRODUCT:{sku}" for each sku
   - else if condition.categoryCodes not empty -> scopeKey = "CATEGORY:{cat}" for each cat
   - ignore PAYMENT_METHOD / CHANNEL / SEGMENT for scope (they are filters)

2) group by (rule.templateCode + scopeKey)

3) in each group keep highest priority rule only
   (this is default "mutual exclusion by scope", not stacking config)
end note

Service <-- DomainService: FinalAppliedRules

'DomainService -> DomainService: filterByStacking(eligibleRules)
'note right of DomainService
'Apply stacking rules from promotion_stacking table
'Filter out non-stackable combinations
'end note
Service <-- DomainService: List<EvaluatePromotionRule>
deactivate DomainService

Service -> Service: transformToEvaluatePromotionRuleResult(EvaluatePromotionRule)
Service --> Controller: EvaluatePromotionRuleResult
deactivate Service

Controller --> Client: 200 OK
note right of Client
return ref: tags: [promotionEvaluation]  ~/openapi/promotion-engine-api.yaml
end note
deactivate Controller

@enduml

